# =============================================================================
# Autonomous Signal Churner & MoScript Governance Hub - Environment Configuration
# =============================================================================
# Copy this file to .env or configure these variables in your Vercel Dashboard
# under Project Settings -> Environment Variables.
# NEVER commit your actual .env file with secrets to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER / HOST DEPLOYMENT (Vercel & Cloud Run)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: Required for live Gemini AI deep quantitative audits and
# macro reasoning reports (/api/ai-audit).
# Get an API key from Google AI Studio: https://aistudio.google.com/
# If left empty, the server automatically falls back to its built-in
# deterministic MCDM mathematical validation engine.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# SOUL_API_KEY: (Optional but Recommended) Shared secret to authenticate
# external bots (Python/Node) connecting to Port 8443 and MoScript compliance.
# Generate with: openssl rand -hex 32
# If set on the server, all external requests must provide this key in
# 'Authorization: Bearer <SOUL_API_KEY>'.
SOUL_API_KEY="YOUR_GENERATED_32_BYTE_HEX_SECRET"

# NODE_ENV: Runtime environment ('production' for live deployments).
NODE_ENV="production"

# APP_URL: The canonical public URL of your deployment (used for self-referential
# endpoints, CORS, and external client connections).
# Example: "https://sigmalui.vercel.app"
APP_URL="https://sigmalui.vercel.app"

# -----------------------------------------------------------------------------
# 2. EXTERNAL CLIENT CONNECTORS (external_client.py & external_client.mjs)
# -----------------------------------------------------------------------------
# These variables configure external algorithmic runners (Scaffs, HFT bots,
# Binance / Bybit execution daemons) connecting into your deployed hub.

# SOUL_API_KEY: Authentication token passed via 'Authorization: Bearer <key>'.
# Must match the SOUL_API_KEY configured in your Vercel server environment.
SOUL_API_KEY="YOUR_GENERATED_32_BYTE_HEX_SECRET"

# SOUL_API_BASE_URL: Target hub URL for external connectors (also accepts SOUL_API_URL).
SOUL_API_BASE_URL="https://sigmalui.vercel.app"
SOUL_API_URL="https://sigmalui.vercel.app"

# APP_NAME: Client node identity identifier registered in the connection mesh.
APP_NAME="Scaffs_Execution_Node_01"

# SOUL_HMAC_SECRET: (Optional) Cryptographic secret for signing and verifying
# signal payload integrity using HMAC-SHA256.
SOUL_HMAC_SECRET=""

# MIN_CONVICTION: Calibrated TOPSIS threshold for emitting signals (default: 0.50).
MIN_CONVICTION="0.50"
